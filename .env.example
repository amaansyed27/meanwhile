# Convex writes these when you run `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk app keys from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL from https://dashboard.clerk.com/apps/setup/convex
# Example: https://verb-noun-00.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Backend owner checks. Prefer Convex token identifiers over subjects/email.
# Comma-separated values are supported.
MNWHL_OWNER_TOKEN_IDENTIFIERS=
MNWHL_OWNER_SUBJECTS=
MNWHL_OWNER_EMAILS=

# Optional seed data gate. Set to true only while running `npm run seed`.
MNWHL_ALLOW_SEEDING=false
