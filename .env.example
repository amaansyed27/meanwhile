# Convex writes these when you run `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Used by Vercel to deploy Convex during production builds.
CONVEX_DEPLOY_KEY=

# Shared between Next API routes and Convex. Generate a long random value.
MNWHL_SERVER_SECRET=

# Owner interface login. This is not for public readers.
MNWHL_OWNER_PASSWORD=
MNWHL_SESSION_SECRET=

# Hashes reader IPs before storing reaction identity in Convex.
MNWHL_REACTION_SALT=

# Deployment surface:
# public for mnwhl.vercel.app, owner for falconwritesmnhl.vercel.app
MNWHL_SURFACE=public
MNWHL_OWNER_URL=

# Optional seed data gate. Set to true only while running `npm run seed`.
MNWHL_ALLOW_SEEDING=false
